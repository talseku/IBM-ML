# Lab: Logistic Regression
# import required libraries
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler

from sklearn.metrics import log_loss
import matplotlib.pyplot as plt

import warnings
warnings.filterwarnings('ignore')

# load data from the URL
url = "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-ML0101EN-SkillsNetwork/labs/Module%203/data/ChurnData.csv"
churn_df = pd.read_csv(url)

# data preprocessing
# select relevant subset of features
#churn_df = churn_df[['tenure', 'age', 'address', 'ed', 'equip', 'churn', 'employ', 'income']]
churn_df = churn_df[['tenure', 'age', 'employ', 'callcard', 'longmon', 'churn']]

churn_df['churn'] = churn_df['churn'].astype('int')

# separate input fields X and target field y
#X = np.asarray(churn_df[['tenure', 'age', 'address', 'ed', 'equip', 'employ', 'income']])
X = np.asarray(churn_df[['tenure', 'age', 'employ', 'callcard', 'longmon']])
y = np.asarray(churn_df['churn'])

# normalize the input dataset to have a standard scale
X_norm = StandardScaler().fit(X).transform(X)

# split the dataset into testing and training data
X_train, X_test, y_train, y_test = train_test_split(X_norm, y, test_size=0.2, random_state=4)

# fit/train the logistic regression classifier model
LR = LogisticRegression().fit(X_train, y_train);

# predict the target field (churn) for the test data
yhat = LR.predict(X_test)

# get the probability of each record belonging to class 0 & 1
# each pair sums to 1.0
yhat_prob = LR.predict_proba(X_test)

# plot the LR coefficient of each input feature to
#   examine what role plays in the prediction of the 1 class
# large positive value means that an increasee in this parameter leads
#   to higher chance of positive (1 class) & large negative the opposite
coefficients = pd.Series(LR.coef_[0], index=churn_df.columns[:-1])
coefficients.sort_values().plot(kind='barh')
plt.title("Feature Coefficients in Logistic Regression Churn Model")
plt.xlabel("Coefficient Value")
plt.show()

# performance evaluation w/ log loss (binary cross entropy loss)
print(log_loss(y_test, yhat_prob))